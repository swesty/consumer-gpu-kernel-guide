From 4fdfc5caed531c2683f9dd441374396e80384545 Mon Sep 17 00:00:00 2001
From: swesty <gitcontact.lethargy549@passmail.net>
Date: Fri, 20 Nov 2026 13:37:10 -0500
Subject: [PATCH] local: auto-select the RoCE v2 GID so b12x RoCE all-reduce
 initialises

The launcher exports NCCL_IB_GID_INDEX=-1 (NCCL's "auto"), but b12x
default_gid_index() passes it straight to ibv_query_gid, so RoCEnante
failed with "Invalid argument" and vLLM fell back to PyNCCL. The IPv4
RoCE v2 GID differs per node (spark-3: 5, spark-4: 4), so a fixed index
cannot go in a shared recipe.

New mod b12x-roce-gid-auto patches default_gid_index() so a negative or
unset index picks the lowest IPv4-mapped RoCE v2 GID common to the HCAs
in B12X_ROCE_HCA/NCCL_IB_HCA, falling back to 3.

Recipes:
- glm-5.3-flash-nvidia-nvfp4: add the mod; gpu_memory_utilization
  0.86 -> 0.84 (RoCE setup adds ~1.3 GiB at startup and spark-4 failed
  the startup memory check; KV is pinned, so no capacity is lost).
- deepseek-v4-flash-0731: add the mod, VLLM_ENABLE_ROCE_ALLREDUCE=1,
  VLLM_ROCE_ALLREDUCE_MAX_SIZE=2MB, gpu_memory_utilization 0.84.

Measured on GLM (fresh-start A/B/A): +7-11% decode at 1 stream.
DeepSeek 0731 path is untested until its next load.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 recipes/deepseek-v4-flash-0731.yaml     | 9 +++++++--
 recipes/glm-5.3-flash-nvidia-nvfp4.yaml | 5 ++++-
 2 files changed, 11 insertions(+), 3 deletions(-)

diff --git a/recipes/deepseek-v4-flash-0731.yaml b/recipes/deepseek-v4-flash-0731.yaml
index a778691..4eb228c 100644
--- a/recipes/deepseek-v4-flash-0731.yaml
+++ b/recipes/deepseek-v4-flash-0731.yaml
@@ -13,7 +13,8 @@ build_args:
 
 cluster_only: true
 
-mods: []
+mods:
+  - mods/b12x-roce-gid-auto
 #  - mods/instanttensor-hybrid-draft-loader
 #   - mods/drop-caches
 
@@ -21,7 +22,8 @@ defaults:
   port: 8000
   host: 0.0.0.0
   tensor_parallel: 2
-  gpu_memory_utilization: 0.85
+  # 0.85 -> 0.84 (2026-11-18): RoCEnante startup work pushed spark-4 under the free-memory check; restore-deepseek0731.sh passes 0.84 too.
+  gpu_memory_utilization: 0.84
   max_model_len: auto
   block_size: 256
   max_num_seqs: 8
@@ -45,6 +47,9 @@ env:
   VLLM_MOE_SKIP_PADDING: "0"
   B12X_MLA_SM120_UNIFIED: "1"
   B12X_MOE_FORCE_A8: "1"
+  # b12x one-shot RoCE all-reduce over the CX7 fabric (needs mods/b12x-roce-gid-auto)
+  VLLM_ENABLE_ROCE_ALLREDUCE: "1"
+  VLLM_ROCE_ALLREDUCE_MAX_SIZE: "2MB"
 
 command: |
   vllm serve deepseek-ai/DeepSeek-V4-Flash-0731 \
diff --git a/recipes/glm-5.3-flash-nvidia-nvfp4.yaml b/recipes/glm-5.3-flash-nvidia-nvfp4.yaml
index 42daee1..3f403c0 100644
--- a/recipes/glm-5.3-flash-nvidia-nvfp4.yaml
+++ b/recipes/glm-5.3-flash-nvidia-nvfp4.yaml
@@ -52,6 +52,7 @@ mods:
   - mods/glm53-nvidia-mtp-unquantized
   - mods/glm53-nvidia-online-mxfp8
   - mods/glm53-port-fork862-prefill-decode-latency
+  - mods/b12x-roce-gid-auto
 
 defaults:
   port: 8000
@@ -66,7 +67,9 @@ defaults:
   num_speculative_tokens: 3
   max_cudagraph_capture_size: 16
   kv_cache_memory_bytes: 6G
-  gpu_memory_utilization: 0.86
+  # 0.86 -> 0.84 (2026-11-18): with RoCEnante on, spark-4's startup check saw 103.3 GiB free vs 104.65 needed.
+  # KV is pinned by kv_cache_memory_bytes, so this only relaxes the startup check.
+  gpu_memory_utilization: 0.84
 
 env:
   HF_HUB_OFFLINE: "1"
-- 
2.43.0

